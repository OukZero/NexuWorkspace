{
  "name": "shutoki",
  "productName": "Shutoki",
  "version": "0.2.0",
  "description": "Gestor local de tareas con timer, horas en Excel y chat con Claude",
  "main": "./out/main/index.js",
  "scripts": {
    "icon": "node tools/make-icon.js",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite build && electron-vite preview",
    "pack": "electron-vite build && electron-builder --win --dir",
    "dist": "electron-vite build && electron-builder --win",
    "launcher": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/install-launcher.ps1",
    "launcher:startup": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/install-launcher.ps1 -Startup",
    "dist:signed": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/dist-signed.ps1",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json"
  },
  "build": {
    "appId": "com.oukzero.shutoki",
    "productName": "Shutoki",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "package.json"
    ],
    "artifactName": "Shutoki-Setup-${version}.${ext}",
    "npmRebuild": false,
    "asarUnpack": [
      "**/node_modules/node-pty/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Shutoki"
    }
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@radix-ui/react-popover": "^1.3.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "exceljs": "^4.4.0",
    "node-pty": "^1.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
