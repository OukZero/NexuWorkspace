{
  "name": "shutoki-ai-workspace",
  "productName": "Nexu Workspace",
  "version": "0.2.1",
  "description": "Gestor local de tareas con timer, horas en Excel y chat con Claude",
  "author": "Martin Escobedo",
  "license": "UNLICENSED",
  "main": "./out/main/index.js",
  "scripts": {
    "icon": "electron tools/make-icon.js",
    "dev": "electron-vite dev",
    "dev:live": "electron-vite dev --watch",
    "live": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/launch-live.ps1",
    "main": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/launch-main.ps1",
    "test:app": "electron-vite build && node tools/test-app.js",
    "test:e2e": "electron-vite build && playwright test",
    "build": "electron-vite build",
    "start": "electron-vite build && electron-vite preview",
    "pack": "electron-vite build && electron-builder --win --dir",
    "release": "electron-vite build && electron-builder --win --publish always",
    "dist": "electron-vite build && electron-builder --win",
    "launcher": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/install-launcher.ps1",
    "launcher:startup": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/install-launcher.ps1 -Startup",
    "dist:signed": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/dist-signed.ps1",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json"
  },
  "build": {
    "appId": "com.mescobedo.shutoki.aiworkspace",
    "publish": [
      {
        "provider": "github",
        "owner": "OukZero",
        "repo": "NexuWorkspace",
        "releaseType": "release"
      }
    ],
    "productName": "Nexu Workspace",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "package.json"
    ],
    "artifactName": "Nexu-Workspace-Setup-${version}.${ext}",
    "npmRebuild": false,
    "asarUnpack": [
      "**/node_modules/node-pty/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/nexo.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Nexu Workspace"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/sora": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@radix-ui/react-popover": "^1.3.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "bpmn-js": "^18.33.1",
    "electron-updater": "^6.8.11",
    "exceljs": "^4.4.0",
    "mermaid": "^12.3.0",
    "node-pty": "^1.1.0",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1"
  }
}
